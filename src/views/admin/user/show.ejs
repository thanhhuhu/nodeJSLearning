<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <meta name="description" content="Hỏi Dân IT - Dự án laptopshop" />
    <meta name="author" content="Hỏi Dân IT" />
    <title>Manager user </title>
    <link href="/admin/css/styles.css" rel="stylesheet" />
    <script src="https://use.fontawesome.com/releases/v6.3.0/js/all.js" crossorigin="anonymous"></script>
</head>
<style>
    body {
        background-color: #f8f9fa; /* nền xám nhạt nhẹ */
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        padding: 40px;
    }

    h1 {
        text-align: center;
        margin-bottom: 30px;
        color: #333;
    }

    .btn-warning {
        background-color: #f0ad4e;
        border: none;
        font-weight: 500;
        padding: 8px 16px;
    }

    .btn-warning:hover {
        background-color: #ec9a2c;
    }

    table {
        background-color: white;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 2px 6px rgba(0,0,0,0.1);
        margin: 20px auto;
    }

    thead {
        background-color: #343a40;
        color: white;
    }

    th, td {
        text-align: center;
        vertical-align: middle;
        padding: 12px;
    }

    tr:hover {
        background-color: #f1f1f1;
        transition: 0.2s ease;
    }

    button {
        background-color: #6c757d;
        color: white;
        border: none;
        border-radius: 4px;
        padding: 5px 10px;
        margin: 3px 0;
        font-size: 0.9rem;
        transition: background-color 0.2s ease;
    }

    button:hover {
        background-color: #5a6268;
    }

    .container {
        max-width: 1100px;
        margin: auto;
    }
</style>

<body class="sb-nav-fixed">

<%- include('../layout/header'); -%>

<div id="layoutSidenav">

    <%- include('../layout/sidenav'); -%>

    <div id="layoutSidenav_content">
        <main>
            <div class="container-fluid px-4">
                <h1 class="mt-4">Manage user</h1>
                <ol class="breadcrumb mb-4">
                    <li class="breadcrumb-item active" ><a href="/admin">Dashboard</a></li>
                    <li class="breadcrumb-item active">User</li>
                </ol>
                <div>

                    <div>
                        <a  href = "/create-user"   class="btn btn-warning"
                            id="button-create-user"
                        >Create a new user</a>
                    </div>
                </div>
                <div>
                    <h3 style="text-align: center">Table user: </h3>
                    <table class="table table-hover" style="width:1000px;justify-content: center " id="">
                        <thead>
                        <th>Id</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Address</th>
                        <th>Action</th>
                        </thead>
                        <tbody>
                        <%users.forEach(function(user){ %>
                            <tr>
                                <td><%= user.id%></td>
                                <td><%= user.name%></td>
                                <td><%= user.email%></td>
                                <td><%= user.address%></td>
                                <td>
                                    <div>
                                        <form action="/handle-delete-user/<%= user.id%>" method="post">

                                            <button type="submit">Delete</button>
                                        </form>
                                        <form action="/handle-view-user/<%= user.id %>" method="get">
                                            <button type="submit">View</button>
                                        </form>
                                    </div>

                                </td>
                            </tr>
                        <%})%>
                        </tbody>
                    </table>

                </div>
            </div>
        </main>
        <%- include('../layout/footer'); -%>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"
        crossorigin="anonymous"></script>
<script src="/admin/js/scripts.js"></script>
</body>

</html>